# OpenAI Configuration
OPEN_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Conversation Memory
MEMORY_MAX_HISTORY_TOKENS=2500
MEMORY_MIN_RECENT_TURNS=2
MEMORY_SUMMARY_MAX_TOKENS=500

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here


# Database Tables
TABLE_PARENT_CHUNKS=parent_documents
TABLE_CHILD_CHUNKS=child_documents
TABLE_CONVERSATION_SESSIONS=conversation_sessions

# Session Management
USE_DATABASE_SESSIONS=true
MAX_ACTIVE_SESSIONS=1000
SESSION_CLEANUP_INTERVAL=3600

# Monitoring
ENABLE_REQUEST_METRICS=true

# Reranker scores rank candidates; zero is not a calibrated answerability gate.
# Leave unset to retain the best candidates even when every score is negative.
# Set only after validating a threshold for the chosen model and dataset.
# RERANK_MIN_TOP_SCORE=0.0

# Browser origins. Use JSON syntax for the list in environment variables.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOWED_ORIGIN_REGEX=https://rag-chatbot-.*\.vercel\.app

# Authentication
# Use a unique random value of at least 32 bytes in production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=30
JWT_CLOCK_SKEW_SECONDS=30
# Enable only after migrations/2026091401_auth_refresh_tokens.sql is applied.
ENABLE_REFRESH_TOKENS=false
REFRESH_TOKEN_EXPIRATION_DAYS=14
REFRESH_COOKIE_NAME=refresh_token
ADMIN_REFRESH_COOKIE_NAME=admin_refresh_token
REFRESH_COOKIE_SAMESITE=lax
# For different production frontend/backend sites, set SameSite=none.

# Expensive AI request protection
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
REQUEST_QUEUE_TIMEOUT=1
MAX_CONTEXT_TOKENS=12000

# OpenTelemetry (disabled until an exporter/collector is available)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=graduation-assistant-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token



# Retrieval Configuration
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# Evaluation Configuration
RAGAS_SAMPLE_SIZE=50
EVALUATION_MODEL=gpt-4o-mini
EVALUATION_DOCUMENT_MANIFEST=config/evaluation_documents.yaml
EVALUATION_PAGE_WINDOW=3
EVALUATION_CANDIDATE_WINDOWS_PER_CASE=8
EVALUATION_CONTEXT_TURNS=3
# Enable only after migration 2026091403 and source PDFs are available.
EVALUATION_AGENT_ENABLED=false

# Model Configuration
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_TOKEN=your_huggingface_token_here

# Logging Configuration
LOG_LEVEL=INFO
